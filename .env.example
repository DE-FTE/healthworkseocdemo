# ─── REQUIRED ─────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

PAGEINDEX_API_KEY=your_pageindex_api_key_here

# ─── PDF STORAGE ──────────────────────────────────────────────────────────────
#
# Option 1 — LOCAL (default, for development)
#   Drop PDF files into the /pdfs folder in the project root.
#
PDF_SOURCE=local
#
# Option 2 — CLOUDFLARE R2 (for production)
#   1. Create an R2 bucket in the Cloudflare dashboard
#   2. Create an API token with R2 read/write permissions
#   3. Upload PDFs into the folder specified by R2_PDF_FOLDER (default: eocdata/)
#   4. Set PDF_SOURCE=r2 and fill in the vars below
#
# PDF_SOURCE=r2
# R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
# R2_ACCESS_KEY_ID=your_r2_access_key_id
# R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
# R2_BUCKET_NAME=eoc-data
# R2_PDF_FOLDER=eocdata

# ─── TUNING ───────────────────────────────────────────────────────────────────
PAGES_PER_NODE=1
MAX_NODES_PER_QUERY=6
SELECTION_MODEL=gpt-4o-mini
ANSWER_MODEL=gpt-4o
